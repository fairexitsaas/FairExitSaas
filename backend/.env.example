# Server Configuration
PORT=5000
NODE_ENV=development

# Client / CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
READ_RATE_LIMIT_MAX=600
WRITE_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20


# ---------------------------------------------------------------------------
# FairExit Phase 1 (see docs/API.md)
# ---------------------------------------------------------------------------
# Read/poll requests have a separate higher budget; write and generation routes remain limited.
APP_WEB_URL=http://localhost:3000

# Claude (prompt v0.6). AI_MODE=mock returns sample JSON so you can build the apps without a key.
AI_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CALL_A_MAX_TOKENS=24000
CALL_A2_MAX_TOKENS=2000
CALL_B_MAX_TOKENS=32000

# Storage buckets (created by sql/002_fairexit_core.sql)
DOCUMENTS_BUCKET=fairexit-documents
REPORTS_BUCKET=fairexit-reports
MAX_UPLOAD_MB=15

# Payments. PAYMENTS_MODE=mock enables POST /cases/:id/checkout/mock (never in production)
PAYMENTS_MODE=mock
REPORT_PRICE_CENTS=5900
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true only after Stripe Tax is activated (Dashboard -> Tax), otherwise Checkout fails
STRIPE_AUTOMATIC_TAX=false
APPLE_IAP_PRODUCT_ID=fairexit.severance_report
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=sandbox
GOOGLE_IAP_PRODUCT_ID=fairexit.severance_report
GOOGLE_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Email (Resend). Empty = emails are logged, not sent
RESEND_API_KEY=
EMAIL_FROM=FairExit <reports@fairexit.io>
OPS_EMAIL=

# Jobs and retention
CRON_SECRET=
RETENTION_DOCS_DAYS=30
RETENTION_REPORT_MONTHS=12
RETENTION_LEADS_MONTHS=12
RUN_JOBS_IN_PROCESS=true

# "Too many scans today"
READS_PER_CASE_PER_DAY=5
SECOND_LOOKS_PER_CASE_PER_DAY=30
BUILDS_PER_CASE_PER_DAY=3

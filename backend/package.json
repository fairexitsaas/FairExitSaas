{
  "name": "fairexit-backend",
  "version": "1.0.0",
  "description": "FairExit Scalable REST API Backend with Express and Supabase",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/push-db.js",
    "regions:build": "node scripts/build-region-data.js ../FairExit-Phase1-Code-2026-10-25",
    "typecheck": "tsc --noEmit",
    "set-role": "node scripts/set-role.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/functions": "^3.10.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "optionalDependencies": {
    "playwright": "^1.64.1"
  },
  "files": [
    "dist",
    "prompts"
  ]
}

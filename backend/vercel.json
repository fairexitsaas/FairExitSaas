{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/jobs/run",
      "schedule": "30 3 * * *"
    }
  ]
}
